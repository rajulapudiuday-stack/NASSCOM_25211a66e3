    {
      "cell_type": "code",
      "metadata": {
        "id": "4e5555f3"
      },
      "source": [
        "# Step 2: Import libraries and generate synthetic cluster data\n",
        "import numpy as np\n",
        "from sklearn.cluster import AffinityPropagation\n",
        "from sklearn.datasets import make_blobs\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "centers = [[1, 1], [-1, -1], [1, -1]]\n",
        "X, labels_true = make_blobs(\n",
        "    n_samples=300, centers=centers, cluster_std=0.5, random_state=0\n",
        ")"
      ],
      "execution_count": 6,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "ee9e16bf",
        "outputId": "343053ae-a8eb-4e31-9373-818d49969d70"
      },
      "source": [
        "# Step 3: Compute and fit Affinity Propagation model\n",
        "afp = AffinityPropagation(preference=-50, random_state=0)\n",
        "afp.fit(X)\n",
        "cluster_centers_indices = afp.cluster_centers_indices_\n",
        "labels = afp.labels_\n",
        "n_clusters_ = len(cluster_centers_indices)\n",
        "print(f\"Estimated number of clusters: {n_clusters_}\")"
      ],
      "execution_count": 8,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Estimated number of clusters: 3\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 486
        },
        "id": "4562ba6d",
        "outputId": "e2e74a31-493a-4e26-b410-982d5c06f98a"
      },
      "source": [
        "# Step 4: Visualize the clustering results\n",
        "plt.figure(figsize=(8, 6))\n",
        "colors = plt.cm.viridis(np.linspace(0, 1, n_clusters_))\n",
        "for k, col in zip(range(n_clusters_), colors):\n",
        "    class_members = labels == k\n",
        "    cluster_center = X[cluster_centers_indices[k]]\n",
        "    plt.plot(X[class_members, 0], X[class_members, 1], 'o', markerfacecolor=col, markeredgecolor='k', markersize=6)\n",
        "    plt.plot(cluster_center[0], cluster_center[1], 'o', markerfacecolor=col, markeredgecolor='k', markersize=14)\n",
        "\n",
        "plt.title(f\"Estimated number of clusters: {n_clusters_}\")\n",
        "plt.grid(True)\n",
        "plt.show()"
      ],
